---
/**
 * Átomo · Button (Figma: componente "Button", tamaños Hero / Footer / Nav).
 * Rectangular, amarillo sólido, sin borde ni esquinas redondeadas; texto en mayúsculas
 * espaciadas y flecha → a la derecha. Hover: fondo #F7D36A y la flecha avanza.
 * Foco: doble anillo paper + navy.
 */
import Icon from './Icon.astro';

interface Props {
  href: string;
  size?: 'hero' | 'footer' | 'nav';
  class?: string;
  target?: string;
  rel?: string;
  'data-motion'?: string;
}
const { href, size = 'hero', class: className = '', target, rel, ...rest } = Astro.props;

const sizes = {
  hero: 'gap-6 px-6 py-4',
  footer: 'w-full max-w-[304px] justify-between h-14 px-6',
  nav: 'gap-4 px-5 py-3',
} as const;
---
<a
  href={href}
  target={target}
  rel={rel}
  class:list={[
    'group/btn inline-flex items-center bg-yellow type-label tracking-[0.08em] text-navy transition-colors',
    'hover:bg-yellow-hover',
    'focus-visible:outline-none focus-visible:shadow-[0_0_0_3px_var(--color-paper),0_0_0_5px_var(--color-navy)]',
    sizes[size],
    className,
  ]}
  {...rest}
>
  <span><slot /></span>
  <Icon name="arrow" size={size === 'nav' ? 16 : 18} strokeWidth={1.75} class="rotate-45 transition-transform duration-300 group-hover/btn:translate-x-1" />
</a>
