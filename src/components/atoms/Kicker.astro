---
/**
 * Átomo · Kicker (overline de sección). Variante "pill": píldora amarilla.
 */
interface Props {
  as?: 'p' | 'span';
  tone?: 'muted' | 'navy' | 'yellow' | 'white' | 'gray';
  variant?: 'plain' | 'pill';
  class?: string;
}
const { as: Tag = 'p', tone = 'muted', variant = 'plain', class: className = '' } = Astro.props;
const tones = {
  muted: 'text-muted',
  navy: 'text-navy',
  yellow: 'text-yellow',
  white: 'text-white',
  gray: 'text-gray-600',
};
---
{variant === 'pill' ? (
  <Tag class:list={['inline-flex items-center bg-yellow px-[18px] py-2 type-overline text-navy', className]}>
    <slot />
  </Tag>
) : (
  <Tag class:list={['flex items-center gap-6 type-overline', tones[tone], className]}>
    <span class="h-[3px] w-12 shrink-0 bg-yellow" aria-hidden="true"></span><slot />
  </Tag>
)}
