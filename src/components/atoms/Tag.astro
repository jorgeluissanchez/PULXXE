---
/** Átomo · Etiqueta sobre foto (Figma: "Etiqueta" / "Índice" / "Leyenda"). */
interface Props { tone?: 'white' | 'yellow' | 'navy'; class?: string }
const { tone = 'white', class: className = '' } = Astro.props;
const tones = { white: 'bg-white text-navy', yellow: 'bg-yellow text-navy', navy: 'bg-navy text-white' };
---
<span class:list={['inline-flex px-3 py-2 type-label-sm', tones[tone], className]}><slot /></span>
