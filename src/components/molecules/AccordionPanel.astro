---
/**
 * Molécula · Panel del acordeón "Obra en acción" (Figma: "Panel / …").
 * Desktop: acordeón horizontal. Mobile: carrusel deslizable; la tarjeta centrada se activa sola.
 * Sin control "Ver video". Abierto: la foto se ve limpia y solo un degradado inferior
 * da contraste al título y la descripción. Cerrado: capa oscura y título compacto.
 *
 * Transición al pasar el mouse (solo CSS, respeta "reducir movimiento"):
 * - El panel se ensancha con una curva suave (flex-grow).
 * - La foto hace un leve zoom y pierde el velo oscuro; los cerrados se oscurecen un poco más.
 * - Una barra amarilla crece en la base del panel abierto.
 * - El título grande, la descripción y el pie entran escalonados desde abajo.
 * - El "+" gira y se desvanece.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../atoms/Icon.astro';
interface Props { index: string; title: string; text: string; foot: string; image: ImageMetadata; alt: string; open?: boolean; i: number }
const { index, title, text, foot, image, alt, open = false, i } = Astro.props;
const ease = 'ease-[cubic-bezier(.22,1,.36,1)]';
// Clases completas para que Tailwind las genere (no se arman por partes):
// lg:ease-[cubic-bezier(.22,1,.36,1)] max-lg:ease-[cubic-bezier(.22,1,.36,1)]
---
<article
  class:list={[
    'group/panel relative isolate flex flex-col overflow-hidden px-6 pb-[31px] pt-7 text-white outline-none',
    // Mobile: tarjeta de carrusel; la del centro es la activa
    'max-lg:h-[460px] max-lg:w-[84%] max-lg:shrink-0 max-lg:snap-center max-lg:scale-[.93] max-lg:opacity-70 max-lg:data-[open=true]:scale-100 max-lg:data-[open=true]:opacity-100',
    'max-lg:transition-[transform,opacity] max-lg:duration-700 max-lg:ease-[cubic-bezier(.22,1,.36,1)]',
    'lg:min-h-0 lg:basis-0 lg:grow data-[open=true]:lg:grow-[2.686]',
    'lg:transition-[flex-grow] lg:duration-[900ms] lg:ease-[cubic-bezier(.22,1,.36,1)] motion-reduce:transition-none',
  ]}
  data-panel={i}
  data-open={open ? 'true' : 'false'}
>
  <!-- Botón que cubre la tarjeta: hace el panel accesible con teclado y lector de pantalla -->
  <button
    type="button"
    class="absolute inset-0 z-10 outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-yellow"
    aria-label={title}
    aria-expanded={open ? 'true' : 'false'}
    data-panel-trigger
  ></button>
  <Image
    src={image}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes="(min-width: 1024px) 760px, 100vw"
    class:list={[
      'absolute inset-0 -z-20 size-full scale-[1.12] object-cover grayscale-[35%]',
      `transition-[transform,filter] duration-[1400ms] ${ease} motion-reduce:transition-none`,
      'group-data-[open=true]/panel:scale-100 group-data-[open=true]/panel:grayscale-0',
    ]}
  />
  <!-- Velo azul noche: oscurece los paneles cerrados y desaparece en el abierto -->
  <div class={`absolute inset-0 -z-10 bg-night/45 transition-opacity duration-700 ${ease} group-data-[open=true]/panel:opacity-0`} aria-hidden="true"></div>
  <!-- Degradado inferior para leer título y descripción -->
  <div class="absolute inset-x-0 top-0 -z-10 h-[22%] bg-[linear-gradient(0deg,rgb(9_30_43/0)_0%,rgb(9_30_43/0.6)_100%)]" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-[62%] bg-[linear-gradient(180deg,rgb(9_30_43/0)_0%,rgb(9_30_43/0.72)_45%,rgb(9_30_43/0.94)_100%)]" aria-hidden="true"></div>
  <!-- Barra amarilla que crece en el panel abierto -->
  <span class={`absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-yellow transition-transform duration-700 ${ease} group-data-[open=true]/panel:scale-x-100 group-data-[open=true]/panel:delay-200`} aria-hidden="true"></span>

  <div class="flex items-start justify-between gap-4">
    <p class={`type-label text-white`}>{index}</p>
    <Icon
      name="plus"
      size={20}
      strokeWidth={1.5}
      class={`hidden shrink-0 transition-[transform,opacity] duration-500 ${ease} group-hover/panel:rotate-90 group-data-[open=true]/panel:rotate-45 group-data-[open=true]/panel:opacity-0 lg:block`}
    />
  </div>

  <div class="mt-auto flex flex-col gap-3 pt-10">
    <div class="relative">
      <h3
        class={`type-h3 transition-[opacity,transform] duration-700 ${ease} group-data-[open=false]/panel:translate-y-6 group-data-[open=false]/panel:opacity-0 group-data-[open=true]/panel:delay-150 max-lg:group-data-[open=false]/panel:sr-only`}
      >{title}</h3>
      <p
        class={`type-h4 transition-[opacity,transform] duration-500 ${ease} group-data-[open=true]/panel:-translate-y-4 group-data-[open=true]/panel:opacity-0 lg:absolute lg:inset-x-0 lg:top-0 max-lg:group-data-[open=true]/panel:hidden`}
        aria-hidden="true"
      >{title}</p>
    </div>
    <div class={`grid transition-[grid-template-rows,opacity,transform] duration-700 ${ease} group-data-[open=false]/panel:translate-y-4 group-data-[open=false]/panel:grid-rows-[0fr] group-data-[open=false]/panel:opacity-0 group-data-[open=true]/panel:grid-rows-[1fr] group-data-[open=true]/panel:delay-300`}>
      <p class="max-w-[620px] overflow-hidden type-body">{text}</p>
    </div>
  </div>
  <p class={`mt-8 hidden type-label transition-[opacity,transform] duration-700 ${ease} group-data-[open=false]/panel:opacity-60 group-data-[open=true]/panel:delay-[400ms] lg:block`}>{foot}</p>
</article>
