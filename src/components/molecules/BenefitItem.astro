---
/** Molécula · Ítem de lista con marcador cuadrado (Figma: "Beneficio" / "Respaldo"). */
import Marker from '../atoms/Marker.astro';
interface Props { tone?: 'navy' | 'yellow'; size?: 'lead' | 'body'; class?: string }
const { tone = 'navy', size = 'lead', class: className = '' } = Astro.props;
---
<li class:list={['flex items-center gap-3.5', size === 'lead' ? 'type-lead' : 'type-body', className]}>
  <Marker tone={tone} />
  <span><slot /></span>
</li>
