---
/**
 * Molécula · Pregunta frecuente (Figma: "Pregunta / 01…07").
 * Abierta: fondo blanco y borde superior amarillo de 3 px. Cerrada: borde navy.
 * Funciona sin JS con <details>; la capa de motion anima la apertura.
 */
import Icon from '../atoms/Icon.astro';
interface Props { q: string; a: string; n: string; open?: boolean }
const { q, a, n, open = false } = Astro.props;
---
<details class="group/faq border-t-[3px] border-navy open:border-yellow open:bg-white" open={open} data-faq>
  <summary class="flex cursor-pointer list-none items-start gap-6 px-6 py-[26px] lap:py-3 [&::-webkit-details-marker]:hidden">
    <span class="type-h4 text-amber-text">{n}</span>
    <span class="flex-1 type-h4 text-navy">{q}</span>
    <span class="flex size-6 shrink-0 items-center justify-center text-navy group-open/faq:rotate-45" aria-hidden="true">
      <Icon name="plus" size={20} strokeWidth={1.5} />
    </span>
  </summary>
  <div class="overflow-hidden" data-faq-body>
    <p class="pb-[26px] pl-[92px] pr-[72px] lap:pb-3 type-body text-muted max-sm:pl-6 max-sm:pr-6">{a}</p>
  </div>
</details>
