---
/** Molécula · Columna de enlaces del pie (Figma: "Columna / …"). */
interface Props { title: string; links: { label: string; href: string; external?: boolean }[] }
const { title, links } = Astro.props;
---
<div class="flex flex-col gap-[13px]">
  <p class="type-label-sm text-light">{title}</p>
  <ul class="flex flex-col gap-[13px]">
    {links.map((l) => (
      <li>
        <a href={l.href} class="type-body text-navy underline-offset-4 hover:underline" {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a>
      </li>
    ))}
  </ul>
</div>
