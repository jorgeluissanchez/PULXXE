---
/** Molécula · Tarjeta de frente de obra (Figma: componente "Project card"). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Tag from '../atoms/Tag.astro';
interface Props { n: string; title: string; meta: string; image: ImageMetadata; alt: string; class?: string }
const { n, title, meta, image, alt, class: className = '' } = Astro.props;
---
<article class:list={['flex flex-col gap-5', className]} data-front-card>
  <div class="relative aspect-[421/440] overflow-hidden lg:aspect-auto lg:h-[clamp(220px,calc(100dvh-405px),440px)]">
    <Image src={image} alt={alt} widths={[420, 640, 860]} sizes="(min-width: 1024px) 421px, (min-width: 640px) 50vw, 100vw" class="size-full object-cover" />
    <Tag tone="yellow" class="absolute left-0 top-0 type-label">{n}</Tag>
  </div>
  <div class="flex flex-col gap-1.5">
    <h3 class="type-h4 text-navy">{title}</h3>
    <p class="type-label-sm text-muted">{meta}</p>
  </div>
</article>
