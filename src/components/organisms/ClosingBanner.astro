---
/** Organismo · Banner de cierre (Figma: "11 · Banner de cierre"). */
import { Image } from 'astro:assets';
import Button from '../atoms/Button.astro';
import { closing } from '@/data/content';
import { whatsappUrl } from '@/data/site';
---
<section id="contacto" class="relative isolate overflow-hidden bg-navy" aria-labelledby="cierre-title" data-banner-parallax>
  <!-- Foto con parallax de scroll: es 30 % más alta y se desplaza según --bp (−1…1) -->
  <Image src={closing.image.src} alt="" widths={[640, 1024, 1440, 1800]} sizes="100vw" class="absolute inset-x-0 -top-[15%] -z-20 h-[130%] w-full translate-y-[calc(var(--bp,0)*12%)] object-cover will-change-transform" />
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(9_30_43/0.92)_0%,rgb(9_30_43/0.6)_38%,rgb(9_30_43/0)_70%)]" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(9_30_43/0.35)_0%,rgb(9_30_43/0)_25%,rgb(9_30_43/0)_80%,rgb(9_30_43/1)_100%)]" aria-hidden="true"></div>

  <div class="mx-auto flex min-h-[551px] max-w-[var(--container-page)] flex-col gap-10 pb-24 pt-[120px] page-x 3xl:px-0">
    <p class="absolute right-[var(--spacing-gutter)] top-16 text-right font-display text-[13px] leading-[22px] tracking-[0.08em] text-yellow uppercase" aria-hidden="true">
      {closing.coords.map((c) => <span class="block">{c}</span>)}
    </p>
    <div class="flex max-w-[760px] flex-col gap-6">
      <h2 id="cierre-title" class="type-h2 text-white">
        <span class="block">{closing.titleLines[0]}</span>
        <span class="block text-yellow">{closing.titleLines[1]}</span>
      </h2>
      <p class="type-lead text-light">{closing.text}</p>
    </div>
    <div class="flex flex-wrap items-center gap-6">
      <Button href={whatsappUrl()} size="footer" target="_blank" rel="noopener">{closing.cta.label}</Button>
    </div>
  </div>
</section>
