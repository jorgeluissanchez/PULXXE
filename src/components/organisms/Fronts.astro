---
/**
 * Organismo · Frentes de obra (Figma: "06 · Frentes de obra").
 * La tarjeta central arranca desfasada; con el scroll sube hasta alinearse con las otras dos
 * (y vuelve a bajar al devolverse). El avance lo calcula src/scripts/interactions.ts en --p.
 */
import Kicker from '../atoms/Kicker.astro';
import FrontCard from '../molecules/FrontCard.astro';
import { fronts } from '@/data/content';
---
<section id="frentes" class="bg-paper page-x max-lg:page-y screen-h screen-y" aria-labelledby="frentes-title">
  <div class="mx-auto flex w-full max-w-[var(--container-page)] flex-col gap-16 lg:gap-[clamp(28px,calc((100dvh-657px)/6+28px),64px)]">
    <header class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-16">
      <div class="flex flex-col gap-6 lg:w-[760px]">
        <Kicker>{fronts.kicker}</Kicker>
        <h2 id="frentes-title" class="type-h2 text-navy">
          {fronts.titleLines.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
      <p class="type-lead text-muted lg:w-[440px]">{fronts.intro}</p>
    </header>

    <div class="-mx-[var(--spacing-gutter)] flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--spacing-gutter)] pb-2 [scrollbar-width:none] lg:mx-0 lg:grid lg:grid-cols-3 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0">
      {fronts.items.map((item, i) => (
        <FrontCard {...item} data-front-shift={i === 1 ? '' : undefined} class:list={[i === 1 && 'lg:[--front-off:clamp(48px,calc((100dvh-657px)/5+48px),96px)] lg:translate-y-[calc(var(--front-off)*(1-var(--p,0)))] lg:will-change-transform', 'w-[290px] shrink-0 snap-start sm:w-[340px] lg:w-auto']} />
      ))}
    </div>
  </div>
</section>
