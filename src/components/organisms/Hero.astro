---
/**
 * Organismo · Hero (Figma: "01 · Hero").
 * PULXXE gigante en amarillo, la casa recortada delante y el contenido sobre la imagen.
 */
import { Image } from 'astro:assets';
import Button from '../atoms/Button.astro';
import Kicker from '../atoms/Kicker.astro';
import { hero } from '@/data/content';
import { whatsappUrl, waMsg } from '@/data/site';
---
<!--
  Desktop: el hero mide exactamente el alto visible (100dvh − header). --u es 1 px del diseño de Figma (1440)
  escalado al ancho (hasta 1.25 en monitores grandes); el título crece con el alto (dvh) y --uw encoge
  PULXXE lo justo para no chocar con el texto. Referencias en Figma: "Prototipo · Laptop" (1366 × 657) y Desktop.
  Parallax con el cursor (desktop): src/scripts/interactions.ts escribe --mx/--my (−1…1) en la sección;
  PULXXE se mueve con el mouse y la casa en sentido contrario, con más recorrido (efecto de profundidad).
  Con el scroll (--sy) PULXXE sube un poco más rápido que la página y la casa baja (va más lenta).
-->
<section
  id="inicio"
  data-hero-parallax
  class="relative overflow-hidden bg-white pt-[65px] [--u:min(1.25px,calc(100vw/1440))] [--uw:min(var(--u),calc((39dvh-35px)/238))]"
>
  <div class="relative mx-auto flex max-w-[1440px] flex-col lg:block lg:h-[calc(100dvh-65px)] lg:min-h-[520px] lg:max-w-[calc(1440*var(--u))]">
    <!-- Palabra de marca decorativa (las letras se pintan con ::before para que no cuenten como texto) -->
    <p
      class="pointer-events-none order-2 select-none whitespace-nowrap pt-4 lg:translate-x-[calc(var(--mx,0)*14px)] lg:translate-y-[calc(var(--my,0)*8px-var(--sy,0)*0.25px)] text-center font-display text-[22.4vw] leading-[0.78] tracking-[-0.01em] text-yellow lg:absolute lg:left-[calc(48*var(--u))] lg:top-[calc(-15*var(--uw))] lg:pt-0 lg:text-left lg:text-[max(200px,calc(325*var(--uw)))]"
      aria-hidden="true"
    >
      <!-- Entrada: cada letra sube desde abajo detrás de una máscara (sin fundido), escalonada -->
      {[...hero.brandWord].map((l, i) => (
        <span class="-mx-[0.06em] -my-[0.1em] inline-block overflow-hidden px-[0.06em] py-[0.1em] align-top">
          <span class="inline-block animate-[letter-rise_1s_cubic-bezier(.22,1,.36,1)_backwards] before:content-[attr(data-l)]" style={`animation-delay:${150 + i * 90}ms`} data-l={l}></span>
        </span>
      ))}
    </p>

    <!-- Casa terminada (recorte PNG) -->
    <div
      class="relative order-3 -mb-[22vw] -ml-[25%] -mt-[10vw] w-[150%] max-w-none lg:absolute lg:left-[calc(465*var(--u))] lg:bottom-[calc(-167*var(--u))] lap:left-[calc(516*var(--u))] lap:bottom-[calc(-157*var(--u))] lg:mb-0 lg:mt-0 lg:ml-0 lg:w-[calc(1212*var(--u))] lg:max-w-none lg:translate-x-[calc(var(--mx,0)*-26px)] lg:translate-y-[calc(var(--my,0)*-14px+var(--sy,0)*0.3px)] lg:will-change-transform"
    >
      <Image
        src={hero.image.src}
        alt={hero.image.alt}
        widths={[640, 960, 1150]}
        sizes="(min-width: 1024px) 1212px, 150vw"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </div>

    <!-- Contenido -->
    <div class="relative order-1 page-x pb-4 pt-8 lg:absolute lg:left-[calc(64*var(--u))] lg:bottom-[clamp(24px,calc(100dvh-780px),calc(64*var(--u)))] lg:w-[calc(542*var(--u))] lg:min-w-[440px] lg:p-0">
      <div class="flex flex-col gap-2">
        <Kicker variant="pill" class="self-start whitespace-nowrap lap:py-1 max-lg:mb-1 max-lg:px-3 max-lg:py-1.5 max-lg:text-[10px] max-lg:tracking-[0.07em] max-[359px]:text-[9px]">{hero.kicker}</Kicker>
        <h1 class="type-h1 text-navy max-lg:text-[min(clamp(52px,38.63px+3.429vw,88px),calc((100vw-48px)/8.4))] lg:text-[max(52px,min(calc(88*var(--u)),calc(21dvh-78px)))]">
          {hero.titleLines.map((line, i) => (
            <span class:list={['block w-fit lg:whitespace-nowrap', i === 2 && 'relative z-0']}>
              {i === 2 && (
                <span class="absolute -inset-x-2 inset-y-0 -z-10 bg-yellow" aria-hidden="true"></span>
              )}
              {line}{i < hero.titleLines.length - 1 && ' '}
            </span>
          ))}
        </h1>
      </div>
      <p class="mt-[26px] max-w-[542px] type-body text-muted lg:mt-[clamp(16px,calc(100dvh-874px+26px),26px)] lg:w-[max(380px,calc(412*var(--u)))]">{hero.description}</p>
      <div class="mt-[26px] flex flex-wrap items-center gap-5 lg:mt-[clamp(16px,calc(100dvh-874px+26px),26px)]">
        <Button href={whatsappUrl(waMsg.asesoria)} size="hero" target="_blank" rel="noopener" class="lap:py-3.5">{hero.primary.label}</Button>
        <a
          href={whatsappUrl(waMsg.ejecutamos)}
          target="_blank"
          rel="noopener"
          class="border-b border-navy pb-1 type-button text-navy hover:border-amber-text hover:text-amber-text"
        >
          {hero.secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>
