---
/**
 * Organismo · Propósito y nosotros (Figma: "02 · Propósito y nosotros").
 * Columna izquierda sticky y cajetín en pares a la derecha.
 */
import Kicker from '../atoms/Kicker.astro';
import { purpose } from '@/data/content';

const { values } = purpose;
const cell = 'border-mist/30';
---
<section id="nosotros" class="relative isolate overflow-clip bg-night page-x page-y" aria-labelledby="nosotros-title">
  <p data-scroll-word class="pointer-events-none absolute left-0 top-0 whitespace-nowrap -z-10 hidden select-none will-change-transform [transform:translate3d(var(--wx,0px),var(--wy,18vh),0)] font-display text-[clamp(260px,62vh,560px)] leading-none tracking-[-0.03em] text-transparent [-webkit-text-stroke:2px_rgb(255_255_255/0.07)] lg:block" aria-hidden="true">NOSOTROS</p>
  <div class="mx-auto flex max-w-[var(--container-page)] flex-col gap-12 lg:flex-row lg:items-start lg:gap-16">
    <!-- Columna fija -->
    <div class="flex flex-col gap-8 lg:sticky lg:top-0 lg:h-svh lg:w-[min(620px,45%)] lg:shrink-0 lg:justify-center lg:-my-[var(--spacing-section)]">
      <div class="flex flex-col gap-7">
        <Kicker tone="yellow">{purpose.kicker}</Kicker>
        <h2 id="nosotros-title" class="type-h2 text-white">
          {purpose.titleLines.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
      <p class="type-lead text-white">{purpose.statement}</p>
    </div>

    <!-- Cajetín en pares -->
    <div class:list={['grid w-full grid-cols-1 border sm:grid-cols-6 lg:max-w-[735px]', cell]}>
      <div class:list={['flex flex-col gap-4 border-b px-7 py-8 sm:col-span-3 sm:border-r lap:py-6', cell]}>
        <p class="font-display text-[clamp(36px,3.4vw,48px)] leading-none text-transparent [-webkit-text-stroke:1px_var(--color-yellow)]">NOSOTROS</p>
        <p class="type-body text-white">{purpose.company.text}</p>
      </div>
      <div class:list={['flex flex-col gap-4 border-b px-7 py-8 sm:col-span-3 lap:py-6', cell]}>
        <p class="font-display text-[clamp(36px,3.4vw,48px)] leading-none text-transparent [-webkit-text-stroke:1px_var(--color-yellow)]">MISIÓN</p>
        <p class="type-body text-white">{purpose.mission.text}</p>
      </div>
      <!-- Visión: fila completa, título y texto lado a lado -->
      <div class:list={['flex flex-col gap-4 border-b px-7 py-8 sm:col-span-6 sm:flex-row sm:items-center sm:gap-10 lap:py-6', cell]}>
        <p class="shrink-0 font-display text-[clamp(36px,3.4vw,48px)] leading-none text-transparent [-webkit-text-stroke:1px_var(--color-yellow)]">VISIÓN <span class="text-[0.5em] [-webkit-text-stroke:0] text-yellow">{purpose.vision.year}</span></p>
        <p class="type-body text-white">{purpose.vision.text}</p>
      </div>
      <!-- Valores: encabezado amarillo + cinco celdas numeradas (filas de tres) -->
      <div class:list={['flex flex-col justify-between gap-6 bg-yellow px-7 py-8 border-b sm:col-span-2 sm:border-r lap:py-6', cell]}>
        <h3 class="font-display text-[28px] sm:text-[clamp(22px,1.85vw,32px)] uppercase leading-[0.95] text-navy">
          {values.label.split(' ').map((w) => <span class="block">{w}</span>)}
        </h3>
        <p class="type-small font-semibold text-navy/80">{values.title}</p>
      </div>
      {values.items.map((v, i) => (
        <div class:list={['flex flex-col gap-3 px-7 py-8 border-b sm:col-span-2 lap:py-6', (i + 1) % 3 !== 2 && 'sm:border-r', cell]}>
          <p class="font-display text-[clamp(36px,3.4vw,48px)] leading-none text-transparent [-webkit-text-stroke:1px_var(--color-yellow)]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <p class="type-overline text-yellow">{v.name}</p>
          <p class="type-small text-mist">{v.text}</p>
        </div>
      ))}

      <div class="grid grid-cols-1 sm:col-span-6 sm:grid-cols-3">
        {purpose.meta.map((m, i) => (
          <div class:list={['flex flex-col gap-1.5 px-7 py-5', i < 2 && 'border-b sm:border-b-0 sm:border-r', cell]}>
            <p class="type-overline text-yellow">{m.label}</p>
            <p class="type-small text-white">{m.value}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
