---
/**
 * Organismo · Resultados (Figma: "07 · Resultados").
 * Tres proyectos distintos. El activo ocupa el carrusel grande (flechas, puntos y miniaturas
 * con sus propias fotos); los otros dos se muestran a la derecha (abajo en mobile). Al elegir
 * uno de ellos, pasa al carrusel y el que estaba pasa a su lugar.
 */
import { Image } from 'astro:assets';
import Kicker from '../atoms/Kicker.astro';
import Tag from '../atoms/Tag.astro';
import Icon from '../atoms/Icon.astro';
import { results } from '@/data/content';
const btn = 'absolute top-1/2 z-10 flex size-12 -translate-y-1/2 items-center justify-center border border-white/80 bg-night/25 text-white opacity-0 backdrop-blur-[2px] transition-[opacity,background-color,color] duration-300 hover:bg-white hover:text-navy group-hover/viewer:opacity-100 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-yellow [@media(hover:none)]:opacity-100';
---
<section class="bg-white page-x max-lg:page-y screen-h screen-y" aria-labelledby="resultado-title">
  <div class="mx-auto flex w-full max-w-[var(--container-page)] flex-col gap-14 lg:min-h-0 lg:flex-1 lg:max-h-[960px] lg:gap-[clamp(24px,calc((100dvh-657px)/6+24px),56px)]">
    <header class="flex flex-col gap-6 lg:flex-row lg:justify-between lg:gap-16">
      <div class="flex flex-col gap-6 lg:w-[760px]">
        <Kicker>{results.kicker}</Kicker>
        <h2 id="resultado-title" class="type-h2 text-navy">
          {results.titleLines.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
      <div class="flex flex-col gap-4 lg:w-[440px]">
        <p class="type-lead text-navy">{results.text}</p>
        <p class="type-h4 text-navy">{results.closing}</p>
      </div>
    </header>

    <div class="grid grid-cols-1 gap-6 lg:min-h-0 lg:flex-1 lg:max-h-[664px] lg:grid-cols-[868fr_420fr] lg:grid-rows-[minmax(0,1fr)]" data-results>
      <!-- Proyecto activo: un carrusel por proyecto; solo se ve el activo -->
      <div class="relative grid min-h-0 min-w-0">
        {results.projects.map((pr, p) => (
          <div class="results-project col-start-1 row-start-1 flex min-h-0 min-w-0 flex-col gap-4" data-results-carousel data-project={p} data-active={p === 0 ? 'true' : 'false'} aria-hidden={p === 0 ? 'false' : 'true'}>
            <div class="group/viewer relative aspect-[4/3] min-h-0 sm:aspect-[868/560] lg:aspect-auto lg:flex-1" role="region" aria-roledescription="carrusel" aria-label={`${pr.name} · ${pr.scope}`}>
              <div class="absolute inset-0 flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-results-track tabindex={p === 0 ? 0 : -1} aria-label={`Fotos de ${pr.name}`}>
                {pr.photos.map((s, i) => (
                  <figure class="relative size-full shrink-0 snap-start" data-slide={i} aria-label={`${i + 1} de ${pr.photos.length}: ${s.tag}`}>
                    <Image src={s.src} alt={s.alt} widths={[480, 768, 1080, 1440, 1736]} sizes="(min-width: 1440px) 868px, (min-width: 1024px) 60vw, 100vw" class="size-full object-cover" loading="lazy" />
                    <figcaption class="absolute bottom-4 left-4 sm:bottom-5 sm:left-5"><Tag>{pr.name} — {s.tag}</Tag></figcaption>
                  </figure>
                ))}
              </div>
              {pr.photos.length > 1 && (
                <>
                  <button type="button" class:list={[btn, 'left-3 hidden sm:flex sm:left-5']} aria-label="Foto anterior" data-results-prev tabindex={p === 0 ? 0 : -1}><Icon name="arrow" size={20} strokeWidth={1.75} class="-rotate-[135deg]" /></button>
                  <button type="button" class:list={[btn, 'right-3 hidden sm:flex sm:right-5']} aria-label="Foto siguiente" data-results-next tabindex={p === 0 ? 0 : -1}><Icon name="arrow" size={20} strokeWidth={1.75} class="rotate-45" /></button>
                </>
              )}
            </div>
            <!-- Miniaturas: en mobile una barra de progreso; desde sm, fotos -->
            <div class="flex gap-1.5 sm:hidden" aria-hidden="true">
              {pr.photos.map((_, i) => (
                <span class="h-1 flex-1 bg-navy/15 transition-colors data-[active=true]:bg-yellow" data-results-dot={i} data-active={i === 0 ? 'true' : 'false'}></span>
              ))}
            </div>
            <div class="hidden grid-cols-5 gap-2 sm:grid">
              {pr.photos.map((s, i) => (
                <button type="button" class="group/thumb relative aspect-[3/2] overflow-hidden outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow lg:aspect-auto lg:h-[clamp(52px,9dvh,80px)]" aria-label={`Ver ${s.tag}`} data-results-thumb={i} data-active={i === 0 ? 'true' : 'false'} tabindex={p === 0 ? 0 : -1}>
                  <Image src={s.src} alt="" widths={[200, 320]} sizes="160px" class="size-full object-cover" />
                  <span class="absolute inset-0 bg-white/45 transition-opacity group-hover/thumb:opacity-0 group-data-[active=true]/thumb:opacity-0" aria-hidden="true"></span>
                  <span class="absolute inset-x-0 bottom-0 h-1 origin-left scale-x-0 bg-yellow transition-transform duration-500 group-data-[active=true]/thumb:scale-x-100" aria-hidden="true"></span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- Otros proyectos: el activo se oculta aquí; al elegir uno, cambia el carrusel -->
      <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:h-full lg:min-h-0 lg:grid-cols-1 lg:grid-rows-[repeat(2,minmax(0,1fr))]">
        {results.projects.map((pr, p) => (
          <button type="button" class:list={['group/side relative block aspect-[4/3] cursor-pointer overflow-hidden text-left outline-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow lg:aspect-auto lg:h-full lg:min-h-0', p === 0 && 'hidden']} aria-label={`Ver proyecto: ${pr.name} · ${pr.scope}`} data-results-pick={p}>
            <Image src={pr.photos[0].src} alt={pr.photos[0].alt} widths={[420, 640, 840]} sizes="(min-width: 1024px) 420px, 50vw" class="absolute inset-0 size-full object-cover transition-transform duration-700 ease-[cubic-bezier(.22,1,.36,1)] group-hover/side:scale-[1.04]" />
            <span class="absolute bottom-3 left-3 sm:bottom-5 sm:left-5"><Tag>{pr.name}</Tag></span>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .results-project { transition: opacity .45s ease, visibility .45s; }
  .results-project[data-active='false'] { opacity: 0; visibility: hidden; pointer-events: none; }
</style>

<script>
  for (const wrap of document.querySelectorAll<HTMLElement>('[data-results]')) {
    const projects = [...wrap.querySelectorAll<HTMLElement>('[data-results-carousel]')];
    const picks = [...wrap.querySelectorAll<HTMLElement>('[data-results-pick]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Carrusel de cada proyecto: flechas, miniaturas, puntos, teclado y deslizar
    const carousels = projects.map((root) => {
      const track = root.querySelector<HTMLElement>('[data-results-track]')!;
      const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
      const dots = [...root.querySelectorAll<HTMLElement>('[data-results-dot]')];
      const thumbs = [...root.querySelectorAll<HTMLElement>('[data-results-thumb]')];
      const current = root.querySelector('[data-results-current]');
      let i = 0;
      const mark = (n: number) => {
        i = n;
        dots.forEach((d, k) => (d.dataset.active = String(k === n)));
        thumbs.forEach((t, k) => (t.dataset.active = String(k === n)));
        if (current) current.textContent = String(n + 1).padStart(2, '0');
      };
      const go = (n: number, instant = false) => {
        const k = (n + slides.length) % slides.length;
        track.scrollTo({ left: slides[k].offsetLeft, behavior: reduce || instant ? 'auto' : 'smooth' });
      };
      let raf = 0;
      const sync = () => { raf = 0; const w = track.clientWidth || 1; mark(Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / w)))); };
      track.addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(sync); }, { passive: true });
      addEventListener('resize', sync);
      root.querySelector('[data-results-prev]')?.addEventListener('click', () => go(i - 1));
      root.querySelector('[data-results-next]')?.addEventListener('click', () => go(i + 1));
      thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
      track.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(i + 1); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go(i - 1); }
      });
      sync();
      return { root, go };
    });

    // Elegir otro proyecto: pasa al carrusel grande (desde su primera foto) y el anterior vuelve a la derecha
    const show = (p: number) => {
      carousels.forEach(({ root, go }, k) => {
        const on = k === p;
        root.dataset.active = String(on);
        root.setAttribute('aria-hidden', String(!on));
        root.querySelectorAll<HTMLElement>('button, [data-results-track]').forEach((el) => (el.tabIndex = on ? 0 : -1));
        if (on) go(0, true);
      });
      picks.forEach((b) => b.classList.toggle('hidden', Number(b.dataset.resultsPick) === p));
      const r = wrap.getBoundingClientRect();
      if (r.top < 65 || r.top > innerHeight * 0.6) wrap.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    };
    picks.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.resultsPick))));
  }
</script>
