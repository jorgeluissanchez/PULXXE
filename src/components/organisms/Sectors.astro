---
/**
 * Organismo · Sectores (Figma: "08 · Sectores" → "Sectores · interactivo").
 * En desktop la sección queda fija y centrada mientras el scroll recorre los 4 sectores.
 */
import { Image } from 'astro:assets';
import Kicker from '../atoms/Kicker.astro';
import SectorRow from '../molecules/SectorRow.astro';
import { sectors } from '@/data/content';
---
<section class="bg-paper page-x page-y" aria-labelledby="sectores-title" data-motion="sectors">
  <div class="mx-auto flex max-w-[var(--container-page)] flex-col gap-12 lg:flex-row lg:gap-24" data-sectors-pin>
    <div class="flex flex-col gap-8 lg:w-[600px] lg:shrink-0">
      <div class="flex flex-col gap-5">
        <Kicker>{sectors.kicker}</Kicker>
        <h2 id="sectores-title" class="type-h2 text-navy">
          {sectors.titleLines.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
      <div id="sector-vista" class="relative aspect-[600/440] overflow-hidden bg-navy" aria-live="polite">
        {sectors.items.map((s, i) => (
          <div
            class="absolute inset-0 flex flex-col justify-end gap-3 p-6 opacity-0 transition-opacity duration-700 data-[active=true]:opacity-100 sm:p-9"
            data-sector-panel={i}
            data-active={i === 0 ? 'true' : 'false'}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <Image src={s.image} alt={s.alt} widths={[600, 900, 1200]} sizes="(min-width: 1024px) 600px, 100vw" class="absolute inset-0 -z-0 size-full object-cover" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(9_30_43/0)_0%,rgb(9_30_43/0.15)_35%,rgb(9_30_43/0.82)_70%,rgb(9_30_43/0.92)_100%)]" aria-hidden="true"></div>
            <p class="relative type-overline text-yellow">Sector</p>
            <h3 class="relative type-h3 text-white">{s.name}</h3>
            <p class="relative type-body text-white">{s.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col lg:w-[616px] lg:pt-7">
      <p class="type-lead text-muted">{sectors.intro}</p>
      <ul class="mt-10" data-sectors-list>
        {sectors.items.map((s, i) => <SectorRow name={s.name} index={i} active={i === 0} />)}
      </ul>
    </div>
  </div>
</section>
