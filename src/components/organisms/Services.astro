---
/**
 * Organismo · Lo que hacemos (Figma: "03 · Lo que hacemos").
 * Encabezado centrado arriba; debajo, al mismo nivel: línea 01 · imagen en franjas · línea 02.
 */
import { Image } from 'astro:assets';
import Kicker from '../atoms/Kicker.astro';
import ServiceBlock from '../molecules/ServiceBlock.astro';
import { services } from '@/data/content';
import { whatsappUrl, waMsg } from '@/data/site';

const [l1, l2] = services.lines;
const titleLast = services.titleLines.at(-1)!.replace(/\.$/, '');
const titleRest = services.titleLines.slice(0, -1);

// 01 a la izquierda (arriba) y 02 a la derecha (abajo, bajo el título)
const blocks = [
  { ...l2, n: '01', href: whatsappUrl(waMsg.edificacion) },
  { ...l1, n: '02', href: whatsappUrl(waMsg.obraCivil) },
];
---
<section id="servicios" class="relative bg-white max-lg:pb-20 max-lg:pt-16 screen-h screen-y" aria-labelledby="servicios-title">
  <div class="relative mx-auto flex w-full max-w-[var(--container-page)] flex-col gap-12 page-x lg:min-h-0 lg:flex-1 lg:gap-[clamp(8px,calc((100dvh-657px)/8+8px),40px)] 3xl:px-0">

    <!-- Encabezado centrado -->
    <header class="mx-auto flex max-w-[960px] flex-col items-center gap-[clamp(8px,1vw,16px)] text-center">
      <Kicker tone="navy">{services.kicker}</Kicker>
      <h2 id="servicios-title" class="font-display text-[clamp(32px,8.6vw,64px)] leading-[0.95] tracking-[-0.01em] text-navy lg:text-[clamp(40px,3.6vw,56px)]">
        <span class="lg:block lg:whitespace-nowrap">{titleRest.join(' ')} </span><span class="lg:block lg:whitespace-nowrap">{titleLast}</span>
      </h2>
      <p class="type-lead text-muted">
        {services.lead.map((l) => <span class="sm:block">{l} </span>)}
      </p>
    </header>

    <!-- Fila: línea 01 · imagen · línea 02. La imagen ocupa las 3 filas; las líneas van en la fila
         del medio (alineadas arriba entre sí) y las filas 1fr de arriba y abajo las centran. -->
    <div class="grid grid-cols-1 gap-12 lg:min-h-0 lg:flex-1 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.3fr)_minmax(0,1fr)] lg:grid-rows-[1fr_auto_1fr] lg:gap-x-[clamp(20px,2.4vw,40px)] lg:gap-y-0">
      <div class="relative z-10 max-lg:order-2 lg:col-start-1 lg:row-start-2"><ServiceBlock block={blocks[0]} stack /></div>

      <div class="relative max-lg:order-1 mx-auto w-full max-w-[520px] lg:col-start-2 lg:row-span-3 lg:row-start-1 lg:h-full lg:min-h-[360px] lg:max-w-none">
        <Image
          src={services.image.src}
          alt={services.image.alt}
          widths={[400, 600, 900, 1135]}
          sizes="(min-width: 1024px) 42vw, 90vw"
          class="h-auto w-full lg:absolute lg:inset-0 lg:size-full lg:object-contain"
        />
      </div>

      <div class="relative z-10 max-lg:order-3 lg:col-start-3 lg:row-start-2"><ServiceBlock block={blocks[1]} stack /></div>
    </div>
  </div>
</section>
