---
/**
 * Organismo · Lo que hacemos (Figma: "03 · Lo que hacemos").
 * Encabezado centrado y escenario: línea 1 · composición en franjas · línea 2.
 */
import { Image } from 'astro:assets';
import Kicker from '../atoms/Kicker.astro';
import { services } from '@/data/content';
---
<section id="servicios" class="bg-paper pb-20 pt-16 lg:py-0 screen-h screen-y" aria-labelledby="servicios-title">
  <div class="mx-auto flex w-full max-w-[1440px] flex-col items-center gap-10 lg:min-h-0 lg:flex-1 lg:max-h-[920px] lg:gap-[clamp(24px,calc((100dvh-657px)/6+24px),40px)]">
    <div class="w-full page-x"><header class="mx-auto flex max-w-[1100px] flex-col items-center gap-4 text-center lap:max-w-none lap:flex-row lap:items-end lap:justify-between lap:text-left">
      <div class="flex flex-col items-center gap-4 lap:items-start">
        <Kicker tone="gray">{services.kicker}</Kicker>
      <h2 id="servicios-title" class="type-h2 text-ink lap:max-w-[720px]">
        {services.titleLines.map((l) => <span class="block">{l}</span>)}
      </h2>
      </div>
      <p class="type-lead text-muted lap:max-w-[420px]">
        {services.lead.map((l) => <span class="block">{l}</span>)}
      </p>
    </header></div>

    <div class="grid w-full grid-cols-1 items-center gap-12 page-x lg:min-h-0 lg:flex-1 lg:grid-cols-[300px_auto_300px] lg:grid-rows-[minmax(0,1fr)] lg:justify-between lg:gap-6 lap:justify-center lap:gap-[72px]">
      {services.lines.map((line, i) => (
        <article
          class:list={[
            'flex flex-col gap-[18px]',
            i === 0 ? 'lg:order-1' : 'lg:order-3 lg:items-end lg:text-right',
          ]}
        >
          <p class="type-label whitespace-pre text-amber-text">{line.line}</p>
          <h3 class="type-h3 text-ink">{line.title}</h3>
          <p class="type-body text-navy">{line.text}</p>
          <span class="h-[3px] w-10 bg-yellow" aria-hidden="true"></span>
          <p class="type-body text-muted">{line.scope}</p>
          <p class="type-label-sm text-navy">{line.audience}</p>
        </article>
      ))}
      <div class="order-first mx-auto w-full max-w-[599px] lg:order-2 lg:h-full lg:max-h-[633px] lg:w-auto lg:max-w-none">
        <Image
          src={services.image.src}
          alt={services.image.alt}
          widths={[400, 600, 900, 1135]}
          sizes="(min-width: 1024px) 599px, 90vw"
          class="h-auto w-full lg:h-full lg:w-auto lg:max-w-none"
        />
      </div>
    </div>
  </div>
</section>
