    lines: [
      'M406.3 96.3L369.7 96.4C370.3 99.9 371.7 102.6 373.8 104.5C376 106.4 378.7 107.3 381.7 107.3C383.8 107.3 386.1 106.6 388.6 105.2C391.2 103.8 393.2 102 394.7 99.7L404.8 106.6C401.7 110.5 398.3 113.4 394.6 115.1C391 116.8 386.7 117.7 381.8 117.7C374.1 117.8 367.8 115.5 362.9 110.9C358.2 106.2 355.8 100.1 355.7 92.6C355.7 85.1 358.1 78.8 362.9 73.7C367.8 68.7 373.9 66.1 381.2 66.1C388.5 66.1 394.5 68.5 399.2 73.5C404 78.4 406.3 84.8 406.4 92.6L406.4 94.2L406.3 96.3',
      'M381.2 76.4C375 76.5 371.2 80 369.7 87.2L392.3 87.1C391.4 80 387.7 76.4 381.2 76.4',
    ],
