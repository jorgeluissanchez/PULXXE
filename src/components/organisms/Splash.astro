const words = ['Planeamos,', 'medimos,', 'cumplimos'];
// columnas de la cortina: salen del centro hacia afuera (orden 2,1,3,0,4)
const colOrder = [3, 1, 0, 2, 4];
---
<div id="splash" aria-hidden="true">
  <div class="sp-cols">
    {colOrder.map((o) => (
      <span class="sp-col" style={`--o:${o}`}><span class="sp-y"></span><span class="sp-c"></span></span>
    ))}
  </div>

  <div class="sp-stage">
    <svg class="sp-brand" viewBox="0 0 410 153" fill="none">
      <g class="sp-iso">
        {pieces.map((p, i) => <path class="sp-piece" style={`--i:${i}`} d={p.d} fill={p.fill} />)}
        {pieces.map((p, i) => (
          <path class="sp-iso-line" style={`--i:${i}`} d={p.d.replace(/Z$/, '')} pathLength="1" stroke="#FAAD01" stroke-width="1.35" />
        ))}
      </g>
      <g class="sp-word">
        {letters.map((l, i) => (
          <g style={`--i:${i}`}>
            <path class="sp-letter" d={l.fill} fill={l.c} />
            {l.lines.map((d) => <path class="sp-letter-line" d={d} pathLength="1" stroke={l.c} stroke-width="1.35" />)}
          </g>
        ))}
      </g>
    </svg>
    <span class="sp-rule"></span>
    <p class="sp-tag">{words.map((w, i) => <span style={`--w:${i}`}>{w}</span>)}</p>
  </div>
</div>

<style is:global>
  #splash { display: none; }
  /* Scroll bloqueado y barra oculta, pero con su hueco reservado (--sbw = ancho de la barra, medido por JS):
     el contenido y los elementos fijos (header, WhatsApp) ya ocupan el ancho final, así que al terminar no salta. */
  html.splash { overflow: hidden; padding-right: var(--sbw, 0px); }
  html.splash .fixed { margin-right: var(--sbw, 0px); }
  /* La entrada del hero (PULXXE gigante) queda en pausa y arranca cuando sube la cortina. */
  html.splash:not(.splash-hero) #inicio *,
  html.splash:not(.splash-hero) #inicio *::before { animation-play-state: paused !important; }
  html.splash #splash {
    --eo: cubic-bezier(.22, 1, .36, 1);
    --eio: cubic-bezier(.65, 0, .35, 1);
    --wipe: cubic-bezier(.76, 0, .24, 1);
    --cream: #f9f9f6;
    --brand-w: min(410px, 72vw);
    position: fixed; inset: 0; z-index: 100; display: block; cursor: pointer;
  }

  /* ── Cortina: crema encima, amarilla debajo ── */
  #splash .sp-cols { position: absolute; inset: 0; display: grid; grid-template-columns: repeat(5, 1fr); }
  #splash .sp-col { position: relative; }
  #splash .sp-y, #splash .sp-c { position: absolute; inset: 0 -1px 0 0; will-change: transform; }
  #splash .sp-y { background: #faad01; }
  #splash .sp-c { background: var(--cream); }

  /* ── Escena ── */
  #splash .sp-stage {
    position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding-bottom: 4vh;
  }
  #splash .sp-brand { width: var(--brand-w); height: auto; overflow: visible; }
  #splash .sp-brand * { transform-box: fill-box; }
  #splash .sp-rule {
    display: block; width: var(--brand-w); height: 2px; margin-top: calc(var(--brand-w) * .066); background: #faad01;
    transform-origin: center; animation: sp-rule-in .35s var(--eo) .2s both;
  }
  #splash .sp-tag {
    margin: calc(var(--brand-w) * .05) 0 0; display: flex; gap: .3em; color: #052242;
    font-family: var(--font-manrope), system-ui, sans-serif; font-size: clamp(13px, 3.4vw, 15px); letter-spacing: .01em;
  }
  #splash .sp-tag span { display: inline-block; animation: sp-word .3s var(--eo) calc(.08s + var(--w) * .21s) both; }

  /* 1 · Planeamos: el isotipo se dibuja */
  #splash .sp-iso-line {
    stroke-dasharray: 1; stroke-linejoin: round;
    animation: sp-draw .3s var(--eo) calc(var(--i) * .04s) both, sp-out .15s var(--eo) calc(.38s + var(--i) * .03s) forwards;
  }
  /* 3 · Cumplimos: las piezas se levantan desde la base */
  #splash .sp-piece { transform-origin: bottom center; animation: sp-rise .32s var(--eo) calc(.3s + var(--i) * .045s) both; }
  /* el isotipo arranca centrado y grande, luego se corre */
  #splash .sp-iso { transform-origin: center; animation: sp-iso .35s var(--eio) .6s both; }
  /* "Pulxxe": trazo → relleno */
  #splash .sp-letter-line {
    stroke-dasharray: 1; stroke-linejoin: round;
    animation: sp-draw .3s var(--eo) calc(.95s + var(--i) * .045s) both, sp-out .15s var(--eo) calc(1.25s + var(--i) * .045s) forwards;
  }
  #splash .sp-letter { animation: sp-in .18s var(--eo) calc(1.13s + var(--i) * .045s) both; }

  /* ── Salida ── */
  html.splash.splash-out #splash { pointer-events: none; }
  html.splash.splash-out #splash .sp-tag { animation: sp-lift .18s var(--eo) both; --lift: -8px; }
  html.splash.splash-out #splash .sp-rule { animation: sp-rule-out .2s var(--eio) .02s both; }
  html.splash.splash-out #splash .sp-brand { animation: sp-lift .22s var(--eo) .06s both; --lift: -16px; }
  html.splash.splash-out #splash .sp-c { animation: sp-wipe .4s var(--wipe) calc(.15s + var(--o) * .04s) both; }
  html.splash.splash-out #splash .sp-y { animation: sp-wipe .4s var(--wipe) calc(.21s + var(--o) * .04s) both; }

  @keyframes sp-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes sp-out { to { opacity: 0; } }
  @keyframes sp-in { from { opacity: 0; } }
  @keyframes sp-rise { from { opacity: 0; transform: scaleY(.4); } 45% { opacity: 1; } }
  @keyframes sp-iso { from { transform: translateX(146px) scale(1.15); } }
  @keyframes sp-rule-in { from { transform: scaleX(.001); } }
  @keyframes sp-rule-out { to { transform: scaleX(.001); } }
  @keyframes sp-word { from { opacity: 0; transform: translateY(6px); } }
  @keyframes sp-lift { to { opacity: 0; transform: translateY(var(--lift)); } }
  @keyframes sp-wipe { to { transform: translateY(-100%); } }

  /* Sin animaciones: logo final, salida con fundido corto */
  @media (prefers-reduced-motion: reduce) {
    html.splash #splash *, html.splash #splash *::before { animation: none !important; }
    #splash .sp-iso-line, #splash .sp-letter-line { opacity: 0; }
    html.splash #splash { transition: opacity .15s ease; }
    html.splash.splash-out #splash { opacity: 0; }
  }
</style>

<script is:inline>
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('splash')) return;
    var el = document.getElementById('splash');
    var reduce = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var start = performance.now();
    var INTRO = reduce ? 600 : 1650; // el logo queda completo a ~1,6 s
    var OUT = reduce ? 200 : 820; // duración de la salida
    var gone = false;

    // Ancho de la barra de scroll (0 en móviles y barras superpuestas) → hueco reservado en CSS
    var probe = document.createElement('div');
    probe.style.cssText = 'position:absolute;top:-999px;width:100px;height:100px;overflow:scroll';
    document.body.appendChild(probe);
    html.style.setProperty('--sbw', probe.offsetWidth - probe.clientWidth + 'px');
    probe.remove();

    // Además del overflow:hidden, se frena rueda/toque/teclas (iOS ignora overflow en <html>)
    var KEYS = { ' ': 1, PageDown: 1, PageUp: 1, ArrowDown: 1, ArrowUp: 1, Home: 1, End: 1 };
    var block = function (e) { e.preventDefault(); };
    var blockKey = function (e) { if (KEYS[e.key]) e.preventDefault(); };
    var pin = function () { if (window.scrollY) window.scrollTo(0, 0); };
    addEventListener('wheel', block, { passive: false });
    addEventListener('touchmove', block, { passive: false });
    addEventListener('keydown', blockKey);
    addEventListener('scroll', pin); // arrastre de la barra
    var unlock = function () {
      removeEventListener('wheel', block); removeEventListener('touchmove', block);
      removeEventListener('keydown', blockKey); removeEventListener('scroll', pin);
    };

    var leave = function () {
      if (gone) return;
      gone = true;
      html.classList.add('splash-out');
      // el hero empieza su entrada cuando la cortina arranca a subir
      setTimeout(function () { html.classList.add('splash-hero'); }, reduce ? 0 : 200);
      setTimeout(function () {
        unlock();
        html.classList.remove('splash', 'splash-out', 'splash-hero');
        if (el) el.remove();
      }, OUT);
    };
    var loaded = new Promise(function (r) { if (document.readyState === 'complete') r(); else addEventListener('load', r, { once: true }); });
    var fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
    Promise.race([Promise.all([fonts, loaded]), new Promise(function (r) { setTimeout(r, 2500); })]).then(function () {
      setTimeout(leave, Math.max(0, INTRO - (performance.now() - start)));
    });
    // saltar: clic, toque o tecla
    ['pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (t) { addEventListener(t, leave, { once: true, passive: true }); });
  })();
</script>
