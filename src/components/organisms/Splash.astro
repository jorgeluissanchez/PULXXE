      'M143.1 57.5L143.2 77.5L149.1 77.4C152.6 77.4 155.3 76.5 157.4 74.7C159.5 72.9 160.5 70.3 160.5 67.1C160.5 60.7 156.7 57.5 149.2 57.5L143.1 57.5',
