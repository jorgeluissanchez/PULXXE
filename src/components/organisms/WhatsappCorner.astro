---
/**
 * Organismo · CTA flotante de WhatsApp (Figma: "CTA flotante · esquina").
 * Cuadrado amarillo pegado a la esquina inferior derecha con halo suave y pulso de anillos.
 * Hover sobrio: solo crece un 6 % desde la esquina (el color no cambia). Respeta "reducir movimiento".
 */
import { whatsappUrl } from '@/data/site';
---
<a
  href={whatsappUrl()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="wa-cta group isolate fixed bottom-0 right-0 z-40 flex size-14 origin-bottom-right items-center justify-center bg-yellow text-navy focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-navy lg:size-16"
>
  <span class="wa-ring pointer-events-none absolute inset-0 -z-10 origin-bottom-right" aria-hidden="true"></span>
  <span class="wa-ring wa-ring-2 pointer-events-none absolute inset-0 -z-10 origin-bottom-right" aria-hidden="true"></span>
  <svg class="size-7 transition-transform duration-500 ease-[cubic-bezier(.22,1,.36,1)] group-hover:scale-105 lg:size-8" width="28" height="28" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
</a>

<style>
  /* Pegado a la esquina inferior derecha. Halo amarillo suave + pulso de anillos.
     Hover sobrio: solo crece un poco desde la esquina. */
  .wa-cta {
    transition: transform 0.4s cubic-bezier(.22, 1, .36, 1), background-color 0.3s ease, box-shadow 0.4s ease;
    box-shadow: 0 0 24px rgb(241 189 41 / 0.28);
  }
  .wa-cta:hover { transform: scale(1.06); box-shadow: 0 0 28px rgb(241 189 41 / 0.32); }
  /* Pulso que llama a la acción: dos anillos que se expanden desde la esquina y se desvanecen */
  /* Anillos rellenos (amarillo + borde ámbar) para que el pulso se vea también sobre fondo claro */
  .wa-ring {
    background: rgb(241 189 41 / 0.45);
    box-shadow: inset 0 0 0 2px rgb(214 158 0 / 0.7);
    animation: wa-ring 2.8s cubic-bezier(.22, 1, .36, 1) infinite;
  }
  .wa-ring-2 { animation-delay: 1.4s; }
  /* Hover: el pulso se acelera (late más rápido) */
  .wa-cta:hover .wa-ring, .wa-cta:focus-visible .wa-ring { animation-duration: 1.1s; }
  .wa-cta:hover .wa-ring-2, .wa-cta:focus-visible .wa-ring-2 { animation-delay: .55s; }
  @keyframes wa-ring {
    0% { transform: scale(1); opacity: 0.9; }
    100% { transform: scale(1.22); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-cta { transition: none; }
    .wa-ring { animation: none; opacity: 0.6; transform: none; }
    .wa-ring-2 { display: none; }
  }
</style>
