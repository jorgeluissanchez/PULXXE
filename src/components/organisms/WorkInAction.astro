---
/**
 * Organismo · Obra en acción (Figma: "05 · Obra en acción" + "Video accordion").
 */
import Kicker from '../atoms/Kicker.astro';
import AccordionPanel from '../molecules/AccordionPanel.astro';
import { workInAction } from '@/data/content';
---
<section class="bg-navy pb-24 pt-16 page-x" aria-labelledby="accion-title">
  <div class="mx-auto flex max-w-[var(--container-page)] flex-col gap-10 lg:gap-[79px]">
    <header class="flex flex-col gap-6 lg:flex-row lg:justify-between" data-motion="reveal">
      <div class="flex flex-col gap-[18px] lg:w-[620px]">
        <Kicker tone="yellow">{workInAction.kicker}</Kicker>
        <h2 id="accion-title" class="type-h2 text-white">
          {workInAction.titleLines.map((l) => <span class="block">{l}</span>)}
        </h2>
      </div>
      <p class="type-lead text-light lg:w-[440px] lg:pt-[60px]">
        {workInAction.intro.map((l) => <span class="block">{l}</span>)}
      </p>
    </header>

    <div class="grid grid-cols-2 gap-3 lg:flex lg:h-[580px] lg:gap-0" data-motion="accordion">
      {workInAction.panels.map((p, i) => <AccordionPanel {...p} i={i} open={i === 0} />)}
    </div>
  </div>
</section>
