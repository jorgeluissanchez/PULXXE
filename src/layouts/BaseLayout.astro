---
/**
 * Layout base: <head> con SEO completo, fuentes auto-alojadas e interacciones básicas (sin animaciones).
 */
import Splash from '@/components/organisms/Splash.astro';
import { Font } from 'astro:assets';
import '@/styles/global.css';
import { site } from '@/data/site';
import { faq } from '@/data/content';
import ogInicio from '@/assets/og-inicio.jpg';
import ogInicioCuadrada from '@/assets/og-inicio-cuadrada.jpg';

/** Imagen para redes: horizontal 1,91:1 (Facebook, LinkedIn, X) + cuadrada opcional (WhatsApp, iMessage). Diseño en Figma, página «🔗 OG · Redes sociales». */
type OgImage = { src: ImageMetadata; alt: string };
const ogDefault: OgImage[] = [
  { src: ogInicio, alt: 'Pulxxe: construcción y remodelación en Barranquilla. Planeamos. Medimos. Cumplimos.' },
  { src: ogInicioCuadrada, alt: 'Pulxxe: construcción y remodelación en Barranquilla. Planeamos. Medimos. Cumplimos.' },
];

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  faqSchema?: boolean;
  /** Imágenes Open Graph de la página; la primera es la principal (y la de X). */
  ogImages?: OgImage[];
}
const { title = site.title, description = site.description, noindex = false, faqSchema = false, ogImages = ogDefault } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogs = ogImages.map((o) => ({ ...o, url: new URL(o.src.src, Astro.site).toString() }));
const og = new URL(ogInicio.src, Astro.site);

const sameAs = Object.values(site.social).filter((u) => new URL(u).pathname.length > 1);
const business = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  '@id': `${Astro.site}#empresa`,
  name: site.name,
  legalName: site.legalName,
  description: site.description,
  url: Astro.site?.toString(),
  logo: new URL('/logo.png', Astro.site).toString(),
  image: og.toString(),
  telephone: site.phone,
  email: site.email,
  slogan: site.tagline,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    ...(site.streetAddress && { streetAddress: site.streetAddress }),
    ...(site.postalCode && { postalCode: site.postalCode }),
    addressLocality: site.city,
    addressRegion: site.region,
    addressCountry: site.country,
  },
  ...(site.openingHours.length && {
    openingHoursSpecification: site.openingHours.map((h) => ({ '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes })),
  }),
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  areaServed: [...site.serviceArea.map((c) => ({ '@type': 'City', name: c })), { '@type': 'State', name: 'Atlántico' }],
  knowsAbout: ['Obra civil', 'Pavimento rígido', 'Drenaje y alcantarillado', 'Edificación', 'Remodelación de casas', 'Remodelación de oficinas'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de construcción',
    itemListElement: ['Obra civil', 'Edificación', 'Remodelación'].map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s, areaServed: 'Barranquilla' } })),
  },
  // Solo perfiles reales (se ignoran los enlaces genéricos tipo https://www.instagram.com/)
  ...(sameAs.length && { sameAs }),
};
const { gtmId, searchConsole, bing } = site.analytics;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#091E2B" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogs.map((o) => (
      <>
        <meta property="og:image" content={o.url} />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content={String(o.src.width)} />
        <meta property="og:image:height" content={String(o.src.height)} />
        <meta property="og:image:alt" content={o.alt} />
      </>
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogs[0].url} />
    <meta name="twitter:image:alt" content={ogs[0].alt} />
    <meta name="geo.region" content="CO-ATL" />
    <meta name="geo.placename" content={site.city} />
    <meta name="geo.position" content={`${site.geo.lat};${site.geo.lng}`} />
    {searchConsole && <meta name="google-site-verification" content={searchConsole} />}
    {bing && <meta name="msvalidate.01" content={bing} />}

    <!-- Splash: se activa antes de pintar (una vez por sesión); sin JS no aparece -->
    <script is:inline>
      try { if (!sessionStorage.getItem('pulxxe-splash')) { document.documentElement.classList.add('splash'); sessionStorage.setItem('pulxxe-splash', '1'); } } catch (e) {}
    </script>
    <Font cssVariable="--font-black-ops" preload />
    <Font cssVariable="--font-manrope" preload />

    <script type="application/ld+json" set:html={JSON.stringify(business)} />

    <!--
      Google Tag Manager vía Partytown (integración oficial de Astro): el contenedor corre en un web worker.
      Google Analytics 4 y cualquier otra etiqueta se configuran DENTRO de GTM, no aquí.
      Con la vista previa de GTM (?gtm_debug=…) se carga de forma normal, porque Tag Assistant no funciona en Partytown.
    -->
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtmId;
        if (/[?&]gtm_debug=/.test(location.search)) { s.async = true; document.head.appendChild(s); }
        else { s.type = 'text/partytown'; document.head.appendChild(s); window.dispatchEvent(new CustomEvent('ptupdate')); }
      </script>
    )}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
  </head>
  <body>
    {gtmId && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`} height="0" width="0" style="display:none;visibility:hidden" title="Google Tag Manager"></iframe></noscript>
    )}
    <Splash />
    <!-- Al recargar, empezar arriba para ver la entrada del hero (el navegador restauraba el scroll) -->
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      if (!location.hash) window.scrollTo(0, 0);
    </script>
    <slot />
    <script>
      import { initInteractions } from '@/scripts/interactions';
      initInteractions();
    </script>
  </body>
</html>
